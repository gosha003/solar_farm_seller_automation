[Unit]
Description=Solar BG outreach: Telegram, Gmail, отправка
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__DIR__
Environment=PYTHONUNBUFFERED=1 PYTHONIOENCODING=utf-8
ExecStart=__DIR__/.venv/bin/python -m solar_outreach.engine --daemon
Restart=always
RestartSec=30
# SIGTERM (deploy, restart) lets the current pass finish, so a letter is never cut off between Gmail and the sheet
TimeoutStopSec=15min
CPUWeight=500
OOMScoreAdjust=-500
# leak safety net: at 400 MB systemd kills and restarts the bot (flock is released automatically)
MemoryHigh=300M
MemoryMax=400M
MemorySwapMax=100M

[Install]
WantedBy=multi-user.target
