[Unit]
Description=Solar BG outreach: Telegram, Gmail, отправка
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__DIR__
Environment=PYTHONUNBUFFERED=1 PYTHONIOENCODING=utf-8
ExecStart=__DIR__/.venv/bin/python -m solar_outreach.engine --daemon
Restart=always
RestartSec=30
CPUWeight=500
OOMScoreAdjust=-500
# страховка от утечек: при 400 МБ systemd убьёт и перезапустит бот (flock снимется сам)
MemoryHigh=300M
MemoryMax=400M
MemorySwapMax=100M

[Install]
WantedBy=multi-user.target
