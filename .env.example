# Copy to .env and fill in. .env is gitignored.
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Filled in automatically by: python -m solar_outreach.google_auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Real sending only with DRY_RUN=false
DRY_RUN=true
# Written by the first `python -m solar_outreach.search` (it creates the sheet)
SPREADSHEET_ID=
# Optional: an external heartbeat URL (e.g. healthchecks.io), pinged every 5 min while the bot works
HEALTHCHECK_URL=
