# Скопируй в .env и заполни. .env в .gitignore. Для GitHub Actions: gh secret set -f .env
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Заполняются автоматически командой: python -m solar_outreach.google_auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Реальная отправка только при DRY_RUN=false (после Фазы 3)
DRY_RUN=true
